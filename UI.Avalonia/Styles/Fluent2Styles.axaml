<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Fluent2CustomResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    
    <!-- typography -->
    <Style Selector="TextBlock.CaptionTextBlockStyle">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="16"/>
    </Style>
    <Style Selector="TextBlock.BodyTextBlockStyle">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style Selector="TextBlock.BodyStrongTextBlockStyle">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- todo: Display font style variant -->
    <Style Selector="TextBlock.SubtitleTextBlockStyle">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="LineHeight" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.TitleTextBlockStyle">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="LineHeight" Value="36"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.TitleLargeTextBlockStyle">
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="LineHeight" Value="52"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.DisplayTextBlockStyle">
        <Setter Property="FontSize" Value="68"/>
        <Setter Property="LineHeight" Value="92"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- textblock -->
    <Style Selector="TextBlock.SecondaryTextBlockStyle">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.Success">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
    </Style>
    <Style Selector="TextBlock.Attention">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}"/>
    </Style>
    <Style Selector="TextBlock.Caution">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
    </Style>
    <Style Selector="TextBlock.Critical">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
    </Style>
    
    <!-- toggleswitch -->
    <Style Selector="ToggleSwitch:unchecked /template/ Ellipse#SwitchKnobOff">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOff}"/>
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchKnobOn">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOn}"/>
    </Style>
    <Style Selector="ToggleSwitch:pointerover /template/ Ellipse">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
    </Style>
    <Style Selector="ToggleSwitch:unchecked:pressed /template/ Ellipse">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Margin" Value="4 0 0 0"></Setter>
    </Style>
    <Style Selector="ToggleSwitch:checked:pressed /template/ Ellipse">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Margin" Value="0 0 4 0"></Setter>
    </Style>
    
    <!-- card -->
    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <!-- todo: settings have more pronounced border, like ControlStrokeColorOnAccentTertiaryBrush -->
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    
    <!-- buttons -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
    </Style>

    <!-- buttons -->
    <!-- FA's caption buttons are plain Buttons inside WindowDrawnDecorations,
         and app-level styles win over ControlTheme setters (Avalonia 12), so the base Button
         restyle below leaks into them. Restore transparent background here;
         keep this in sync with any future theme upgrade. -->
    <Style Selector="WindowDrawnDecorations /template/ Button">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- WinUI's caption hover is a neutral highlight in light but the accent color in dark
         (generic.xaml: WindowCaptionButtonBackgroundPointerOver = SystemControlHighlightBaseLowBrush);
         FA only ships the neutral one, so the accent is scoped to the dark theme via resource. -->
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_MinimizeButton:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource CaptionButtonBackgroundHover}"/>
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_MaximizeButton:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource CaptionButtonBackgroundHover}"/>
    </Style>
    <!-- WinUI's close button hover/pressed backgrounds (#e81123/#f1707a, both themes) already match
         FA's .Close theme; only the pressed glyph differs (WinUI: black). -->
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_CloseButton:pressed /template/ ui|FAFontIcon#ButtonIcon">
        <Setter Property="Foreground" Value="Black"/>
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Button.inactive /template/ ui|FAFontIcon#ButtonIcon">
        <Setter Property="Foreground" Value="{DynamicResource CaptionGlyphInactive}"/>
    </Style>
    <!-- scoped to min/max: close keeps FA's .Close white glyph on hover, even when inactive -->
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_MinimizeButton.inactive:pointerover /template/ ui|FAFontIcon#ButtonIcon">
        <Setter Property="Foreground" Value="{DynamicResource CaptionGlyphNormal}"/>
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_MaximizeButton.inactive:pointerover /template/ ui|FAFontIcon#ButtonIcon">
        <Setter Property="Foreground" Value="{DynamicResource CaptionGlyphNormal}"/>
    </Style>
    <!-- the generic .inactive rule above still matches close on hover; force the WinUI white glyph -->
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_CloseButton.inactive:pointerover /template/ ui|FAFontIcon#ButtonIcon">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- the app draws its own title -->
    <Style Selector="WindowDrawnDecorations:has-titlebar /template/ Panel#PART_TitleTextPanel">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- custom buttons -->
    <!-- transparent -->
    <Style Selector="Button.Transparent">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.Transparent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
    </Style>
    <!-- link -->
    <Style Selector="Button.Link">
        <Setter Property="Foreground" Value="{DynamicResource LinkButtonForeground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.Link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.Link:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource LinkButtonForegroundTertiary}"/>
    </Style>
    <!-- accent -->
    <Style Selector="Button.Accent">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
    </Style>
    <Style Selector="Button.Accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.Accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AccentTextFillColorTertiaryBrush}"/>
    </Style>
    <!-- inverted accent -->
    <Style Selector="Button.AccentInverted">
        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        <Setter Property="Background" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
    </Style>
    <!-- status -->
    <Style Selector="Button.Caution">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>
    </Style>
    
    <!-- expander -->
    <Style Selector="Expander">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
    </Style>
    <Style Selector="Expander.Success ToggleButton">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
    </Style>
    <Style Selector="Expander.Critical ToggleButton">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
    </Style>
    <!-- FA's theme only changes the header border + chevron pill on hover/press; these fill the whole
         title row. Scoped to plain expanders so Success/Critical headers stay solid (pre-port layering:
         app-level class setters beat the theme's state rules). -->
    <Style Selector="Expander:not(.Success):not(.Critical) /template/ ToggleButton#ExpanderHeader:pointerover">
        <Setter Property="Background" Value="{DynamicResource ExpanderHeaderBackgroundPointerOver}"/>
    </Style>
    <Style Selector="Expander:not(.Success):not(.Critical) /template/ ToggleButton#ExpanderHeader:pressed">
        <Setter Property="Background" Value="{DynamicResource ExpanderHeaderBackgroundPressed}"/>
    </Style>

    <!-- combobox -->
    <!-- WinUI's ComboBoxItem radius is 3; FA defaults to ControlCornerRadius (4).
         Item spacing comes from FA's template (5,2,5,2), so no margin override. -->
    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    
    <!-- textbox: focus stripe lives in Fluent2TextBox.axaml (full template override) -->

    <!-- progress bar -->
    <!-- WinUI values are 1.5/0.5; on Avalonia v11's built-in theme these had to be doubled (3/1)
         due to a rendering quirk — the keys live in Fluent2CustomResources so each value can be
         re-tested under FA by editing one line. -->
    <Style Selector="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource ProgressBarBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForeground}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource ProgressBarBorderThemeThickness}"/>
        <Setter Property="MinHeight" Value="{DynamicResource ProgressBarMinHeight}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ProgressBarCornerRadius}"/>
    </Style>
    <Style Selector="ProgressBar:horizontal /template/ Border#ProgressBarRoot">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ProgressBar:horizontal /template/ Border#PART_Indicator">
        <Setter Property="MinHeight" Value="{DynamicResource ProgressBarMinHeight}"/>
        <Setter Property="Height" Value="{DynamicResource ProgressBarMinHeight}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ProgressBarCornerRadius}"/>
    </Style>
    <Style Selector="ProgressBar:horizontal /template/ Panel#DeterminateRoot">
        <Setter Property="Background" Value="{DynamicResource ProgressBarBackground}"/>
        <Setter Property="MinHeight" Value="{DynamicResource ProgressBarTrackHeight}"/>
        <Setter Property="Height" Value="{DynamicResource ProgressBarTrackHeight}"/>
    </Style>
    <!-- Target the track border by name: a bare "Border" here also matches PART_Indicator and,
         with no specificity in Avalonia, would override the indicator's own radius. -->
    <Style Selector="ProgressBar:horizontal /template/ Border#ProgressBarTrack">
        <Setter Property="CornerRadius" Value="{DynamicResource ProgressBarTrackCornerRadius}"/>
    </Style>
</Styles>
