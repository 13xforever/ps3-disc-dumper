<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- WinUI values are 1.5/0.5; on Avalonia v11's built-in theme these had to be doubled (3/1)
         due to a rendering quirk — kept as resources so the doubling can be re-tested under FA.
         Our definitions win over FA's same-named keys: Styles.TryGetResource checks later-declared
         styles first, and FluentAvaloniaTheme is declared before our styles in App.axaml. -->
    <CornerRadius x:Key="ProgressBarCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="ProgressBarTrackCornerRadius">1</CornerRadius>

    <!-- expander (FA 3.1.0 key names; the built-in theme's ExpanderHeader*PointerOver/Pressed spellings are not
         referenced by FA's template) -->
    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{DynamicResource CardBackgroundFillColorDefault}"/>
    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="{DynamicResource CardStrokeColorDefault}"/>
    <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="{DynamicResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="{DynamicResource ControlStrokeColorDefault}"/>
    <SolidColorBrush x:Key="ExpanderHeaderForegroundPointerOver" Color="{DynamicResource TextFillColorPrimary}"/>
    <!-- tertiary -->
    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="{DynamicResource CardBackgroundFillColorSecondary}"/>
    <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="{DynamicResource ControlStrokeColorDefault}"/>
    <!-- FA references this key in the unchecked-press rule but never defines it -->
    <SolidColorBrush x:Key="ExpanderBorderPressedBrush" Color="{DynamicResource ControlStrokeColorDefault}"/>
    <SolidColorBrush x:Key="ExpanderHeaderForegroundPressed" Color="{DynamicResource TextFillColorSecondary}"/>
    <!-- expander chevron: FA's base background/border are already transparent with 0 thickness; only the
         hover/press pill backgrounds need neutralizing -->
    <SolidColorBrush x:Key="ExpanderChevronPointerOverBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ExpanderChevronPressedBackground" Color="Transparent"/>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#5d5d5d"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White"/>
            <SolidColorBrush x:Key="LinkButtonForeground" Color="{DynamicResource SystemAccentColorDark2}"/>
            <SolidColorBrush x:Key="LinkButtonForegroundTertiary" Color="{DynamicResource SystemAccentColorDark1}"/>
            <!-- whole-header hover fill (Fluent2Styles.axaml); FA defines no such key -->
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="{DynamicResource ControlStrokeColorForStrongFillWhenOnImage}"/>
            <SolidColorBrush x:Key="ProgressBarForeground" Color="{DynamicResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="CaptionGlyphNormal" Color="Black"/>
            <SolidColorBrush x:Key="CaptionGlyphInactive" Color="#999999"/>
            <!-- WinUI light caption hover = neutral highlight (same value as FA's CaptionButtonBackgroundPointerOver) -->
            <SolidColorBrush x:Key="CaptionButtonBackgroundHover" Color="Black" Opacity="0.09"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#cecece"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="Black"/>
            <SolidColorBrush x:Key="LinkButtonForeground" Color="{DynamicResource SystemAccentColorLight3}"/>
            <SolidColorBrush x:Key="LinkButtonForegroundTertiary" Color="{DynamicResource SystemAccentColorLight2}"/>
            <!-- whole-header hover fill, dark accent shade (see Light dict) -->
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="{DynamicResource ControlFillColorSecondary}"/>
            <SolidColorBrush x:Key="ProgressBarForeground" Color="{DynamicResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="CaptionGlyphNormal" Color="White"/>
            <SolidColorBrush x:Key="CaptionGlyphInactive" Color="{DynamicResource CaptionGlyphInactiveColor}"/>
            <!-- WinUI dark caption hover = accent (SystemControlHighlightBaseLowBrush / SystemColorHighlightColor) -->
            <SolidColorBrush x:Key="CaptionButtonBackgroundHover" Color="{DynamicResource SystemAccentColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
